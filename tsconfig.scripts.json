{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "panda-ui/*": ["./styled-system/*"],
      "panda-ui-mithril": ["./src/index.js"]
    }
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-playground"]
}
