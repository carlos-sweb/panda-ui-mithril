{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "strictNullChecks": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "panda-ui/*": ["./styled-system/*"],
      "panda-ui-mithril": ["./src/index.js"]
    }
  },
  "include": [
    "config-ui/**/*.d.ts",
    "config-ui/i18n/**/*.js",
    "config-ui/jsx-language.js"
  ],
  "exclude": ["node_modules", "dist", "dist-playground"]
}
